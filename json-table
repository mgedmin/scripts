#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = [
#     "rich>=15.0.0",
# ]
# ///

"""
Read a JSON list of records from stdin or file, format them as a table.
"""

import argparse
import json
import pathlib
import sys

from rich import box
from rich.console import Console, RenderableType
from rich.json import JSON
from rich.style import NULL_STYLE, Style, StyleType
from rich.table import Table
from rich.text import Text
from rich.theme import Theme


parser = argparse.ArgumentParser(description=__doc__.strip())
parser.add_argument("filename", nargs='?', metavar="filename.json")
parser.add_argument(
    "-r",
    "--rename-columns",
    metavar="COL1=FIELD1,COL2=FIELD2,...",
    help="comma-separated list of column names and field names for them",
)
parser.add_argument(
    "-o",
    "--column-order",
    metavar="COL1,COL2,...",
    help=(
        "comma-separated list of columns for changing display order"
        " (columns not listed here will be added in order of appearance)"
    ),
)
parser.add_argument(
    "-H",
    "--hide-columns",
    metavar="COL1,COL2,...",
    help="comma-separated list of columns to remove from output",
)
parser.add_argument(
    "-O",
    "--only-columns",
    metavar="COL1,COL2,...",
    help=(
        "comma-separated list of columns to display"
        " (columns not listed here will be removed from output)"
    ),
)
parser.add_argument(
    "--align-right", "--right-align",
    metavar="COL1,COL2,...",
    help="comma-separated list of columns for right-alignment",
)
parser.add_argument(
    "-s",
    "--sort",
    metavar="[,-]COL1,[-]COL2,...",
    help=(
        "comma-separated list of column names for sorting rows"
        " (a - prefix reverses the order)"
    ),
)
parser.add_argument(
    "-W",
    "--no-wrap",
    action='store_true',
    help="truncate table cells instead of wrapping",
)
parser.add_argument(
    "--row-style",
    metavar="COL",
    help="column to use for row styles",
)
parser.add_argument(
    "--hyperlink",
    metavar="COL",
    help="column to use for hyperlinks",
)


SIMPLE_ASCII = box.Box(
    "    \n"
    "    \n"
    " -  \n"
    "    \n"
    "    \n"
    " -  \n"
    "    \n"
    "    \n"
)


THEME = Theme({
    'title': 'bright_blue',
    'json.key': 'bright_blue',
    'separator': 'bright_blue',
    'json.str': 'green',
    'json.number': 'white',
    'json.bool_true': 'white',
    'json.bool_false': 'white',
    'json.null': 'bright_black',
    'other_value': 'white',
    'error': 'red',
})


def styled_text(
    text: str, base_style: str, style_override: Style
) -> RenderableType:
    style = THEME.styles[base_style]
    if style_override:
        style += style_override
    return Text.styled(text, style=style)


def value2str(value: object, style: Style = NULL_STYLE) -> RenderableType:
    match value:
        case None:
            return styled_text('null', 'json.null', style)
        case True:
            return styled_text('true', 'json.bool_true', style)
        case False:
            return styled_text('false', 'json.bool_false', style)
        case str():
            return styled_text(value, 'json.str', style)
        case int() | float():
            return styled_text(str(value), 'json.number', style)
        case list() | dict():
            return JSON.from_data(value)
        case _:
            # can't happen probably
            return styled_text(str(value), 'other_value', style)


def print_error(msg: str, style: StyleType = 'error') -> None:
    console = Console(theme=THEME, stderr=True)
    console.print(Text(msg, style=style))


def main():
    console = Console(theme=THEME)

    args = parser.parse_args()

    if args.only_columns and args.column_order:
        parser.error(
            "--only-columns and --column-order are mutually exclusive"
        )
    if args.only_columns and args.hide_columns:
        parser.error(
            "--only-columns and --hide-columns are mutually exclusive"
        )

    if not args.filename or args.filename == '-':
        if sys.stdin.isatty():
            parser.error('refusing to read from a terminal')
        data = sys.stdin.read()
    else:
        data = pathlib.Path(args.filename).read_text()

    if not data:
        print_error("input is empty")
        sys.exit(1)

    try:
        records = json.loads(data)
    except json.JSONDecodeError as e:
        print_error(f"JSON parse error: {e}")
        lines = data.splitlines()
        if 1 <= e.lineno <= len(lines):
            print_error(lines[e.lineno - 1])
            print_error(f'{"^":>{e.colno}}')
        sys.exit(1)

    if not isinstance(records, list):
        print_error("JSON data is not a list")
        sys.exit(1)

    if not records:
        console.print(Text("no data", style='null_value'))
        return

    # mapping of column names to maximum widths
    columns = {}
    min_width = {}
    right_align = set()
    hide_columns = set()
    if args.align_right:
        for c in map(str.strip, args.align_right.split(',')):
            if c:
                right_align.add(c)
    if args.hide_columns:
        for c in map(str.strip, args.hide_columns.split(',')):
            if c:
                hide_columns.add(c)
    if args.only_columns:
        for c in map(str.strip, args.only_columns.split(',')):
            if c:
                columns[c] = None
    elif args.column_order:
        for c in map(str.strip, args.column_order.split(',')):
            if c and c not in hide_columns:
                columns[c] = None
    field2col = {}
    col2field = {}
    if args.rename_columns:
        for cf in args.rename_columns.split(","):
            col, _, field = cf.partition('=')
            col = col.strip()
            field = field.strip()
            field2col[field] = col
            col2field[col] = field
    for n, record in enumerate(records):
        if not isinstance(record, dict):
            print_error(f"Item [{n}] is not an object")
            console.print(JSON.from_data(record))
            sys.exit(1)
        for k, v in record.items():
            c = field2col.get(k, k)
            if not args.only_columns and c not in hide_columns:
                columns[c] = None
            if args.no_wrap:
                match s := value2str(v):
                    case str() | Text() if '\n' not in s:
                        min_width[c] = max(
                            min_width.get(c, 0), min(40, len(s))
                        )

    available_space = console.width
    for c in columns:
        is_sensible = 0 < min_width.get(c, 0) < 40
        min_width[c] = max(min_width.get(c, 0), len(c))
        if is_sensible:
            available_space -= min_width[c] - 2

    if args.sort:
        for c in reversed(args.sort.split(',')):
            c = c.strip()
            if not c:
                continue
            reverse = c.startswith('-')
            c = c.removeprefix('-')
            field = col2field.get(c, c)
            records.sort(
                key=lambda r: (str(type(r.get(field))), r.get(field)),
                reverse=reverse,
            )

    table = Table(
        box=SIMPLE_ASCII,
        show_edge=False,
        pad_edge=False,
        header_style='title',
        border_style='separator',
        padding=(0, 1, 0, 0),
    )
    for c in columns:
        table.add_column(
            Text(c, justify='left'),
            no_wrap=args.no_wrap,
            min_width=min_width.get(c),
            max_width=available_space,
            justify='right' if c in right_align else 'left',
        )

    style = NULL_STYLE
    style_field = col2field.get(args.row_style, args.row_style)
    hyperlink_field = col2field.get(args.hyperlink, args.hyperlink)
    for record in records:
        if style_field:
            style = Style.parse(record.get(style_field))
        values = [record.get(col2field.get(c, c)) for c in columns]
        styles = [style] * len(columns)
        if hyperlink_field and styles:
            styles[0] = styles[0].update_link(record.get(hyperlink_field))
        table.add_row(
            *(
                value2str(value, style)
                for value, style in zip(values, styles)
            ),
            style=style
        )
    console.print(table)


if __name__ == "__main__":
    main()
